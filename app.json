{
  "expo": {
    "name": "Torculas-SmartHome",
    "slug": "Torculas-SmartHome",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "torculassmarthome",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.torculassmarthome"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.torculassmarthome"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Bunken Tech Sans Pro Bold",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/BunkenTechSansPro-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Bunken Tech Sans Pro ExBd",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/BunkenTechSansPro-ExBd.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./src/assets/fonts/BunkenTechSansPro-Bold.ttf",
              "./src/assets/fonts/BunkenTechSansPro-ExBd.ttf"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "befe9703-0640-4a7a-8c23-07b3910b1998"
      }
    }
  }
}
